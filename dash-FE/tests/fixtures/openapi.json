s/ApiResponseMemberProfileResponse"}}}},"401":{"description":"로그인이 필요함","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMemberProfileResponse"}}}},"403":{"description":"학생 인증이 필요함","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMemberProfileResponse"}}}}},"security":[{"bearerAuth":[]}]}},"/api/members/me/ideal-preference":{"get":{"tags":["이상형 조건"],"summary":"내 이상형 조건 조회","description":"저장된 이상형 조건을 조회합니다.","operationId":"get_1","responses":{"200":{"description":"이상형 조건 조회 성공","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseIdealPreferenceResponse"}}}},"401":{"description":"로그인이 필요함","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseIdealPreferenceResponse"}}}},"403":{"description":"학생 인증 또는 프로필 완료가 필요함","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseIdealPreferenceResponse"}}}},"404":{"description":"저장된 이상형 조건이 없음","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseIdealPreferenceResponse"}}}}},"security":[{"bearerAuth":[]}]},"put":{"tags":["이상형 조건"],"summary":"내 이상형 조건 저장·수정","description":"조건 전체를 교체합니다. 학생 인증과 프로필 완료가 필요합니다.","operationId":"save_1","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/IdealPreferenceRequest"}}},"required":true},"responses":{"200":{"description":"이상형 조건 저장 성공","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseIdealPreferenceResponse"}}}},"400":{"description":"요청 형식 또는 입력값이 올바르지 않음","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseIdealPreferenceResponse"}}}},"401":{"description":"로그인이 필요함","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseIdealPreferenceResponse"}}}},"403":{"description":"학생 인증 또는 프로필 완료가 필요함","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseIdealPreferenceResponse"}}}}},"security":[{"bearerAuth":[]}]}},"/api/student-verifications":{"post":{"tags":["학생 인증"],"summary":"모바일 학생증 인증","description":"모바일 학생증 이미지를 업로드해 학생 인증을 완료합니다.\n\n입력 학번, Code 39 바코드 학번, OCR 학번이 모두 일치해야 하며,\n입력 이름과 OCR 이름도 일치해야 합니다.\nJPEG 또는 PNG만 업로드할 수 있습니다.\n","operationId":"verify","requestBody":{"content":{"multipart/form-data":{"schema":{"$ref":"#/components/schemas/StudentVerificationRequest"}}}},"responses":{"201":{"description":"학생 인증 성공","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseStudentVerificationResponse"}}}},"400":{"description":"이미지 형식, 바코드, OCR 결과 또는 입력 정보가 올바르지 않음","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseStudentVerificationResponse"}}}},"401":{"description":"로그인이 필요함","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseStudentVerificationResponse"}}}},"409":{"description":"이미 학생 인증을 완료했거나 다른 회원이 사용한 학번","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseStudentVerificationResponse"}}}},"413":{"description":"업로드 가능한 파일 크기를 초과함","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseStudentVerificationResponse"}}}}},"security":[{"bearerAuth":[]}]}},"/api/meetings":{"get":{"tags":["미팅"],"summary":"미팅 목록 조회","description":"활성 상태이고 예정 시각이 현재보다 미래인 미팅을 조회합니다.\n미팅 ID 내림차순이며 정원이 찬 미팅도 포함합니다.\n성별 정원, 현재 인원과 로그인한 회원의 참여 여부를 반환합니다.\n초대 코드와 채팅방 ID는 해당 미팅 참여자에게만 반환합니다.\ncursor를 생략하면 첫 페이지를 조회합니다.\n다음 페이지에는 응답의 nextCursor를 사용합니다.\n조회 시 기회는 차감하지 않습니다.\n","operationId":"getMeetings","parameters":[{"name":"cursor","in":"query","description":"이 ID보다 작은 미팅을 조회","required":false,"schema":{"type":"integer","format":"int64"}},{"name":"size","in":"query","description":"조회 개수, 1~50","required":false,"schema":{"type":"integer","format":"int32","default":10},"example":10}],"responses":{"200":{"description":"조회 성공. 미팅이 없으면 빈 목록","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMeetingPageResponse"}}}},"400":{"description":"조회 파라미터 오류","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMeetingPageResponse"}}}},"401":{"description":"로그인이 필요함","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMeetingPageResponse"}}}},"403":{"description":"서비스 이용 조건을 충족하지 않음","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMeetingPageResponse"}}}}},"security":[{"bearerAuth":[]}]},"post":{"tags":["미팅"],"summary":"미팅 개설","description":"미팅을 개설하고 개설자를 참여자로 등록합니다.\n성별 총 정원은 각각 2~5명이며 개설자도 정원에 포함됩니다.\n예정 시각은 한국 시간 기준 현재보다 미래여야 합니다.\n성공 시 기회 1회를 차감하고 미팅 채팅방을 생성합니다.\n미팅 생성, 참여 등록, 채팅방 생성과 기회 차감은\n함께 성공하거나 함께 취소됩니다.\n","operationId":"create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MeetingCreateRequest"}}},"required":true},"responses":{"201":{"description":"미팅 개설 및 채팅방 생성 성공","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMeetingCreateResponse"}}}},"400":{"description":"입력값 오류 또는 현재보다 미래가 아닌 예정 시각","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMeetingCreateResponse"}}}},"401":{"description":"로그인이 필요함","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMeetingCreateResponse"}}}},"403":{"description":"서비스 이용 조건을 충족하지 않음","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMeetingCreateResponse"}}}},"409":{"description":"남은 기회가 없음","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMeetingCreateResponse"}}}}},"security":[{"bearerAuth":[]}]}},"/api/meetings/{meetingId}/join":{"post":{"tags":["미팅"],"summary":"미팅 참여","description":"활성 상태이고 예정 시각이 현재보다 미래인 미팅에 참여합니다.\n본인 성별의 정원이 남아 있어야 합니다.\n이미 참여 중인 회원은 중복 참여할 수 없습니다.\n성공 시 기회 1회를 차감하고 기존 미팅 채팅방에 참여합니다.\n참여 등록, 기회 차감과 채팅방 참여는\n함께 성공하거나 함께 취소됩니다.\n참여 후 미팅 정보와 초대 코드, 채팅방 ID를 반환합니다.\n","operationId":"join","parameters":[{"name":"meetingId","in":"path","description":"참여할 미팅 ID","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"미팅 및 채팅방 참여 성공","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMeetingResponse"}}}},"400":{"description":"미팅 ID 형식 오류","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMeetingResponse"}}}},"401":{"description":"로그인이 필요함","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMeetingResponse"}}}},"403":{"description":"서비스 이용 조건을 충족하지 않음","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMeetingResponse"}}}},"404":{"description":"미팅 또는 연결된 채팅방이 존재하지 않음","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMeetingResponse"}}}},"409":{"description":"참여 불가능한 미팅, 중복 참여, 성별 정원 초과,\n남은 기회 없음 또는 종료된 채팅방\n","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMeetingResponse"}}}}},"security":[{"bearerAuth":[]}]}},"/api/meetings/join-by-code":{"post":{"tags":["미팅"],"summary":"초대 코드로 미팅 참여","description":"초대 코드에 해당하는 미팅에 참여합니다.\n코드는 앞뒤 공백을 제거하고 대문자로 변환합니다.\n활성 상태이고 예정 시각이 현재보다 미래여야 하며,\n본인 성별의 정원이 남아 있어야 합니다.\n이미 참여 중인 회원은 중복 참여할 수 없습니다.\n성공 시 기회 1회를 차감하고 기존 미팅 채팅방에 참여합니다.\n참여 등록, 기회 차감과 채팅방 참여는\n함께 성공하거나 함께 취소됩니다.\n","operationId":"joinByCode","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MeetingJoinByCodeRequest"}}},"required":true},"responses":{"200":{"description":"미팅 및 채팅방 참여 성공","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMeetingResponse"}}}},"400":{"description":"요청 본문 또는 초대 코드 형식 오류","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMeetingResponse"}}}},"401":{"description":"로그인이 필요함","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMeetingResponse"}}}},"403":{"description":"서비스 이용 조건을 충족하지 않음","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMeetingResponse"}}}},"404":{"description":"초대 코드에 해당하는 미팅 또는 연결된 채팅방이 존재하지 않음","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMeetingResponse"}}}},"409":{"description":"참여 불가능한 미팅, 중복 참여, 성별 정원 초과,\n남은 기회 없음 또는 종료된 채팅방\n","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMeetingResponse"}}}}},"security":[{"bearerAuth":[]}]}},"/api/dating/requests":{"post":{"tags":["소개팅"],"summary":"소개팅 신청","description":"상대 회원에게 소개팅을 신청합니다.\n로그인, 이메일 인증, 학생 인증과 프로필 완료가 필요합니다.\n신청 성공 시 신청자의 기회를 1회 차감합니다.\n메시지는 선택 입력이며 최대 500자입니다.\n두 회원 사이에 대기 중이거나 수락된 신청이 있으면\n방향에 관계없이 다시 신청할 수 없습니다.\n거절된 신청만 있다면 다시 신청할 수 있습니다.\n","operationId":"create_1","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DatingRequestCreateRequest"}}},"required":true},"responses":{"201":{"description":"소개팅 신청 성공","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseDatingRequestResponse"}}}},"400":{"description":"입력값 오류 또는 본인에게 신청","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseDatingRequestResponse"}}}},"401":{"description":"로그인이 필요함","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseDatingRequestResponse"}}}},"403":{"description":"서비스 이용 조건을 충족하지 않음","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseDatingRequestResponse"}}}},"404":{"description":"신청 대상 회원이 없음","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseDatingRequestResponse"}}}},"409":{"description":"중복 신청, 상대 이용 불가 또는 기회 부족","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseDatingRequestResponse"}}}}},"security":[{"bearerAuth":[]}]}},"/api/dating/requests/{requestId}/reject":{"post":{"tags":["소개팅"],"summary":"소개팅 신청 거절","description":"신청을 받은 회원만 대기 중인 신청을 거절할 수 있습니다.\n거절 시 기회를 차감하거나 채팅방을 생성하지 않습니다.\n이미 수락하거나 거절한 신청에는 다시 응답할 수 없습니다.\n요청 본문은 필요하지 않습니다.\n","operationId":"reject","parameters":[{"name":"requestId","in":"path","description":"거절할 소개팅 신청 ID","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"거절 성공","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseDatingRequestResponse"}}}},"400":{"description":"신청 ID 형식이 올바르지 않음","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseDatingRequestResponse"}}}},"401":{"description":"로그인이 필요함","content":{"*/*":{"schema":{"$ref":"#/components/schema